{
  "name": "actio",
  "version": "0.1.0",
  "description": "Actio desktop task manager with pomodoro and analytics",
  "author": "a2n",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "lint": "node scripts/lint.mjs",
    "test": "node --test tests/*.test.js",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac dmg",
    "dist:mac:zip": "electron-builder --mac zip",
    "dist:win": "electron-builder --win nsis",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:all": "electron-builder --mac dmg --win nsis --linux AppImage deb"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.a2n.actio",
    "productName": "actio",
    "icon": "build/icons/icon-source.png",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icons/icon-source.png",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon-source.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons/icon-source.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

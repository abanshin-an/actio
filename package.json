{
  "name": "actio",
  "version": "0.1.0",
  "description": "Actio desktop task manager with pomodoro and analytics",
  "author": "a2n",
  "main": "src/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "start:docker": "electron --no-sandbox --disable-setuid-sandbox --disable-gpu --disable-dev-shm-usage --disable-software-rasterizer .",
    "lint": "node scripts/lint.mjs",
    "test": "node --test tests/*.test.js",
    "db:seed-demo": "node scripts/create-demo-db.mjs",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:mac:x64": "electron-builder --mac dmg --x64 --publish never",
    "dist:mac:arm64": "electron-builder --mac dmg --arm64 --publish never",
    "dist:mac:all": "electron-builder --mac dmg --x64 --arm64 --publish never",
    "dist:mac:zip": "electron-builder --mac zip --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "dist:win:x64": "electron-builder --win nsis --x64 --publish never",
    "dist:win:arm64": "electron-builder --win nsis --arm64 --publish never",
    "dist:win:portable:x64": "electron-builder --win portable --x64 --publish never",
    "dist:win:all": "electron-builder --win nsis --x64 --arm64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:linux:x64": "electron-builder --linux AppImage deb --x64 --publish never",
    "dist:linux:arm64": "electron-builder --linux AppImage deb --arm64 --publish never",
    "dist:linux:all": "electron-builder --linux AppImage deb --x64 --arm64 --publish never",
    "dist:all": "electron-builder --mac dmg --win nsis --linux AppImage deb --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.a2n.actio",
    "productName": "actio",
    "icon": "build/icons/icon-source.png",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icons/icon-source.png",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon-source.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons/icon-source.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
